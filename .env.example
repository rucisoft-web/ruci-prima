APP_NAME="Ruci PRIMA"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://prima.domainanda.co.id
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning

# MySQL dari cPanel (format nama biasanya: userCpanel_namadb)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpaneluser_asetcare
DB_USERNAME=cpaneluser_asetcare
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=240
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Email cPanel (opsional, untuk reset kata sandi)
MAIL_MAILER=smtp
MAIL_HOST=mail.domainanda.co.id
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=noreply@domainanda.co.id
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@domainanda.co.id"
MAIL_FROM_NAME="${APP_NAME}"

# ---- Ruci PRIMA ----
# MFA (aplikasi autentikator). true = wajib bagi semua akun.
ASSET_MFA_REQUIRED=false
# Batas laporan kerusakan lewat pindai QR per menit per alamat IP.
ASSET_QR_REPORTS_PER_MINUTE=6

# Admin platform dibuat saat "php artisan migrate --seed" bila diisi.
ASSET_ADMIN_EMAIL=
ASSET_ADMIN_PASSWORD=

# Data contoh Grand Pasundan Convention Hotel. Matikan untuk produksi.
ASSET_DEMO=false
ASSET_DEMO_PASSWORD="Demo#2026aset"
